# Copy to .env and fill. Validated via Joi/Zod at startup.
NODE_ENV=development
# --- API ---
DATABASE_URL=postgresql://quantsmind:quantsmind@localhost:5432/quantsmind?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-internal-token
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=3000

# --- AI Service ---
INTERNAL_TOKEN=dev-internal-token
MODEL_PATH=./models
MODEL_DEVICE=cpu
MODEL_VERSION=v1

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_METERED=price_...
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/settings/billing

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_SENTRY_DSN=
VITE_APP_NAME=Quantsmind

# --- Monitoring ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Auth provider toggle: jwt | clerk | auth0 ---
AUTH_PROVIDER=jwt
